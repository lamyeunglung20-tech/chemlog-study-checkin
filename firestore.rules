rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'lamyeunglung20@gmail.com';
    }

    function validRewardItem(reward) {
      return reward is map
        && reward.keys().hasOnly(['id', 'stickerCost', 'label', 'icon'])
        && reward.id in ['milk-tea', 'lunch', 'signature', 'photo']
        && reward.stickerCost is int
        && reward.stickerCost >= 1
        && reward.stickerCost <= 999
        && reward.label is string
        && reward.label.size() >= 1
        && reward.label.size() <= 80
        && reward.icon is string
        && reward.icon.size() >= 1
        && reward.icon.size() <= 16;
    }

    function hasConfiguredRewards() {
      let config = get(/databases/$(database)/documents/appConfig/public).data;
      return config.keys().hasAny(['rewards'])
        && config.rewards is list
        && config.rewards.size() <= 4;
    }

    function configuredRewardMatches(index) {
      let config = get(/databases/$(database)/documents/appConfig/public).data;
      return hasConfiguredRewards()
        && config.rewards.size() > index
        && request.resource.data.rewardId == config.rewards[index].id
        && request.resource.data.rewardLabel == config.rewards[index].label
        && request.resource.data.stickerCost == config.rewards[index].stickerCost;
    }

    match /appConfig/public {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['appName', 'subtitle', 'loginHeading', 'loginCopy', 'championMessage', 'footerQuote', 'iconData', 'backgroundColor', 'rewards', 'updatedAt'])
        && request.resource.data.appName is string
        && request.resource.data.appName.size() >= 1
        && request.resource.data.appName.size() <= 30
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() >= 0
        && request.resource.data.subtitle.size() <= 60
        && request.resource.data.loginHeading is string
        && request.resource.data.loginHeading.size() >= 1
        && request.resource.data.loginHeading.size() <= 40
        && request.resource.data.loginCopy is string
        && request.resource.data.loginCopy.size() >= 1
        && request.resource.data.loginCopy.size() <= 100
        && request.resource.data.championMessage is string
        && request.resource.data.championMessage.size() >= 1
        && request.resource.data.championMessage.size() <= 80
        && request.resource.data.footerQuote is string
        && request.resource.data.footerQuote.size() >= 1
        && request.resource.data.footerQuote.size() <= 120
        && request.resource.data.iconData is string
        && request.resource.data.iconData.size() <= 180000
        && (request.resource.data.iconData == '' || request.resource.data.iconData.matches('data:image/(jpeg|png|webp);base64,.*'))
        && request.resource.data.backgroundColor is string
        && request.resource.data.backgroundColor.matches('#[0-9a-fA-F]{6}')
        && request.resource.data.rewards is list
        && request.resource.data.rewards.size() <= 4
        && (request.resource.data.rewards.size() < 1 || validRewardItem(request.resource.data.rewards[0]))
        && (request.resource.data.rewards.size() < 2 || validRewardItem(request.resource.data.rewards[1]))
        && (request.resource.data.rewards.size() < 3 || validRewardItem(request.resource.data.rewards[2]))
        && (request.resource.data.rewards.size() < 4 || validRewardItem(request.resource.data.rewards[3]))
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create: if isVerifiedOwner(userId)
        && request.resource.data.keys().hasOnly(['studyDate', 'minutes', 'topic', 'note', 'hasImage', 'hasStartImage', 'hasEndImage', 'createdAt'])
        && request.resource.data.studyDate is string
        && request.resource.data.studyDate.size() == 10
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 1
        && request.resource.data.minutes <= 720
        && (request.resource.data.topic in ['mistakes', 'notes', 'flashcards', 'practice_questions', 'practice_papers', 'concepts', 'mc', 'structured', 'experiment', 'pastpaper']
          || (request.resource.data.topic is string
            && request.resource.data.topic.size() >= 8
            && request.resource.data.topic.size() <= 37
            && request.resource.data.topic.matches('custom:.+')))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80
        && request.resource.data.hasImage == true
        && request.resource.data.hasStartImage == true
        && request.resource.data.hasEndImage == true
        && existsAfter(/databases/$(database)/documents/users/$(userId)/sessionImages/$(sessionId + '-start'))
        && existsAfter(/databases/$(database)/documents/users/$(userId)/sessionImages/$(sessionId + '-end'))
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isVerifiedOwner(userId) || isAdmin();
    }

    match /users/{userId}/sessionImages/{sessionId} {
      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create: if isVerifiedOwner(userId)
        && request.resource.data.keys().hasOnly(['imageData', 'createdAt'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 720000
        && request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isVerifiedOwner(userId) || isAdmin();
    }

    match /users/{userId}/draftImages/{draftId} {
      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create, update: if isVerifiedOwner(userId)
        && draftId == 'studyStart'
        && request.resource.data.keys().hasOnly(['imageData', 'updatedAt'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 720000
        && request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isVerifiedOwner(userId) || isAdmin();
    }

    match /users/{userId}/preferences/{preferenceId} {
      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create, update: if isVerifiedOwner(userId)
        && preferenceId == 'studyTopics'
        && request.resource.data.keys().hasOnly(['customTopics', 'updatedAt'])
        && request.resource.data.customTopics is list
        && request.resource.data.customTopics.size() <= 20
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /users/{userId}/redemptions/{redemptionId} {
      function validReward() {
        return configuredRewardMatches(0)
          || configuredRewardMatches(1)
          || configuredRewardMatches(2)
          || configuredRewardMatches(3)
          || (!hasConfiguredRewards() && ((request.resource.data.rewardId == 'milk-tea'
            && request.resource.data.rewardLabel == '$40 元以下的奶茶一杯'
            && request.resource.data.stickerCost == 10)
          || (request.resource.data.rewardId == 'lunch'
            && request.resource.data.rewardLabel == '$60 元內的午餐'
            && request.resource.data.stickerCost == 15)
          || (request.resource.data.rewardId == 'signature'
            && request.resource.data.rewardLabel == '藍老師的親筆簽名'
            && request.resource.data.stickerCost == 20)
          || (request.resource.data.rewardId == 'photo'
            && request.resource.data.rewardLabel == '與藍老師合照一張'
            && request.resource.data.stickerCost == 30)));
      }

      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create: if isVerifiedOwner(userId)
        && request.resource.data.keys().hasOnly(['rewardId', 'rewardLabel', 'stickerCost', 'status', 'deducted', 'createdAt'])
        && validReward()
        && request.resource.data.status == 'pending'
        && request.resource.data.deducted == false
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/leaderboard/$(userId)).data.totalMinutes / 60
          + get(/databases/$(database)/documents/leaderboard/$(userId)).data.get('stickerBonusCount', 0)
          - get(/databases/$(database)/documents/leaderboard/$(userId)).data.get('removedStickerCount', 0)
          >= request.resource.data.stickerCost;
      allow update: if isAdmin()
        || (isVerifiedOwner(userId)
          && resource.data.status == 'pending'
          && resource.data.deducted == false
          && request.resource.data.status == 'cancelled'
          && request.resource.data.deducted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt is timestamp);
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isVerifiedOwner(userId) || isAdmin();
      allow create, update: if isVerifiedOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /leaderboard/{userId} {
      function validLeaderboardWrite() {
        return (isVerifiedOwner(userId) || isAdmin())
          && request.resource.data.keys().hasOnly(['displayName', 'totalMinutes', 'weekMinutes', 'monthMinutes', 'weekKey', 'monthKey', 'removedStickerCount', 'stickerBonusCount', 'isAdmin', 'avatarData', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 40
          && request.resource.data.totalMinutes is int
          && request.resource.data.totalMinutes >= 0
          && request.resource.data.totalMinutes <= 5256000
          && request.resource.data.weekMinutes is int
          && request.resource.data.weekMinutes >= 0
          && request.resource.data.weekMinutes <= 10080
          && request.resource.data.monthMinutes is int
          && request.resource.data.monthMinutes >= 0
          && request.resource.data.monthMinutes <= 44640
          && request.resource.data.weekKey is string
          && request.resource.data.weekKey.size() == 10
          && request.resource.data.monthKey is string
          && request.resource.data.monthKey.size() == 7
          && (!request.resource.data.keys().hasAny(['removedStickerCount'])
            || (request.resource.data.removedStickerCount is int
              && request.resource.data.removedStickerCount >= 0
              && request.resource.data.removedStickerCount <= 87600))
          && (!request.resource.data.keys().hasAny(['stickerBonusCount'])
            || (request.resource.data.stickerBonusCount is int
              && request.resource.data.stickerBonusCount >= 0
              && request.resource.data.stickerBonusCount <= 87600))
          && (!request.resource.data.keys().hasAny(['isAdmin'])
            || (request.resource.data.isAdmin is bool
              && (isAdmin() || request.resource.data.isAdmin == false)))
          && (!request.resource.data.keys().hasAny(['avatarData'])
            || (request.resource.data.avatarData is string
              && request.resource.data.avatarData.size() <= 120000
              && request.resource.data.avatarData.matches('data:image/jpeg;base64,.*')))
          && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isVerifiedUser();
      allow create: if validLeaderboardWrite()
        && (isAdmin() || !request.resource.data.keys().hasAny(['removedStickerCount', 'stickerBonusCount']));
      allow update: if validLeaderboardWrite()
        && (isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['removedStickerCount', 'stickerBonusCount']));
      allow delete: if isAdmin();
    }

    match /leaderboardAvatars/{userId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isVerifiedOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly(['avatarData', 'updatedAt'])
        && request.resource.data.avatarData is string
        && request.resource.data.avatarData.size() <= 120000
        && request.resource.data.avatarData.matches('data:image/jpeg;base64,.*')
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isVerifiedOwner(userId) || isAdmin();
    }
  }
}
